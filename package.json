{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vela — a model-agnostic, offline-first desktop AI workspace",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:harness": "vitest run --config tests/harness/mock-provider/vitest.config.ts",
    "mock-provider": "node tests/harness/mock-provider/src/cli.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "verify": "pnpm typecheck && pnpm test && pnpm test:harness && cd src-tauri && cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
