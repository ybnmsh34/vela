# Rust / Tauri build artifacts
target/
**/*.rs.bk
*.pdb

# Node
node_modules/
.pnpm-store/
dist/
dist-ssr/
build/
*.tsbuildinfo

# Test / coverage output
coverage/
.vitest/
playwright-report/
test-results/
.nyc_output/

# Local data — Vela is offline-first and writes a local SQLite database plus a
# vector store. None of it belongs in version control, and it may contain
# conversation content.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.vela-data/

# Credentials — belt and braces. API keys live in the OS keychain and must
# never reach disk, but do not let an accidental dotenv slip through either.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
